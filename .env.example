# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Empty values fall back to the defaults shown in comments.

# LLM provider: openai | gemini | groq (default: openai)
LLM_PROVIDER=openai

# Per-provider model names (defaults shown)
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# API keys -- only the selected provider's key is needed for real runs
OPENAI_API_KEY=
# GOOGLE_API_KEY is also accepted for Gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# Speech-to-text: tiny | base | small | medium | large-v3 (default: tiny, for CPU development)
WHISPER_MODEL_SIZE=tiny

# Stereo calls: which channel carries the agent, left | right (default: left).
# The other channel is labelled customer; mono audio gets a single speaker_1 label.
AGENT_CHANNEL=left

# Transcript cache: raw speech-to-text segments keyed by the audio's SHA-256 and the model
# size, so re-running identical audio skips transcription. Entries hold unredacted call
# text and are created owner-only. on | off (default: on); off means no reads and no writes.
TRANSCRIPT_CACHE=on
# Cache directory, relative to the working directory (default: .cache/transcripts)
TRANSCRIPT_CACHE_DIR=.cache/transcripts

# LangSmith tracing (LANGSMITH_TRACING_V2, LANGCHAIN_TRACING_V2, LANGCHAIN_TRACING, LANGCHAIN_API_KEY
# and LANGCHAIN_PROJECT are also accepted; the *_TRACING_V2 names take precedence)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
